/* Example branding override for the kiosk SPA.
 *
 * To enable: copy this file to e.g. `branding/theme.css` and set
 *   branding.custom_css_path: "./branding/theme.css"
 * in kiosk.yaml or controller.yaml. The binary serves the file at
 * /branding/custom.css and the SPA injects a <link rel="stylesheet">
 * for it after Tailwind, so the rules below win the cascade.
 * Cache-Control is 5 minutes; reload the page after edits.
 *
 * Tailwind 4 emits every color utility as a `var(--color-<name>)`
 * reference, so overriding the variable cascades through every `.bg-*`,
 * `.text-*`, `.border-*` utility (and their alpha variants via
 * color-mix) without naming any class directly. The variables below
 * are the stable surface — see README → "Branding → Custom CSS
 * overrides" for the full discussion.
 */

:root {
  /* Primary action accent: commit button, "New X" buttons, focus
   * rings, any element wearing bg-brand-primary / text-brand-primary. */
  --color-brand-primary: #6d28d9;        /* violet-700 */
  --color-brand-primary-hover: #7c3aed;  /* violet-600 */

  /* Full surface palette — Tailwind's slate scale, addressable as
   * variables. Uncomment to re-skin the page / cards / borders / text.
   * Convention in the SPA: high-number slate = darker (backgrounds),
   * low-number slate = lighter (text). For a light theme, invert the
   * lightness so slate-950 becomes the page's lightest tone and
   * slate-100 becomes near-black.
   *
   * --color-slate-950: #100b21;  // page background
   * --color-slate-900: #1a1530;  // cards, dialogs
   * --color-slate-800: #2d2348;  // buttons, table headers
   * --color-slate-700: #3f3263;
   * --color-slate-600: #5a4a8c;
   * --color-slate-500: #7d6fab;
   * --color-slate-400: #a395c8;  // muted text
   * --color-slate-300: #c5bbe0;  // body text
   * --color-slate-200: #e0d9ee;  // titles
   * --color-slate-100: #f3eefb;  // strong text
   */
}

/* -------------------------------------------------------------------
 * Utility-class overrides (fragile)
 *
 * For anything the color variables don't cover — border-radius,
 * spacing, animations — you can target Tailwind utility classes by
 * name. Class names change as the UI evolves, so this is "use at your
 * own risk and re-check after each upgrade." If you find yourself
 * overriding the same class on a lot of selectors, file an issue and
 * we'll consider promoting it to a variable.
 *
 * .rounded-2xl { border-radius: 0.5rem; }
 * ------------------------------------------------------------------- */
