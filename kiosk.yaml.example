kiosk:
  code: "KC-MAIN-01"
  location_code: "MAIN"

server:
  port: 8090
  bind: "127.0.0.1"

session:
  idle_timeout: "5m"
  cart_grace_period: "30s"

scanning:
  user_qr_prefix: "U:"
  item_barcode_prefix: ""

returns:
  allow_cross_user: true
  allow_uncorrelated: true

# Optional. Customize the kiosk's visual identity. All keys are optional;
# omitted values fall back to built-in defaults. The example logo + tagline
# below match the file shipped at ./branding/logo.svg in the repo.
branding:
  logo_path: "./branding/logo.svg"   # served at /branding/logo (PNG or SVG)
  tagline: "Tool & Consumable Checkout"
  primary_color: ""                   # CSS color (e.g. "#059669") for primary action buttons
