kiosk:
  code: "KC-MAIN-01"
  location_code: "MAIN"

server:
  port: 8090
  bind: "127.0.0.1"

session:
  idle_timeout: "5m"
  cart_grace_period: "30s"

scanning:
  user_qr_prefix: "U:"
  item_barcode_prefix: ""

returns:
  allow_cross_user: true
  allow_uncorrelated: true

# Optional NATS event publishing. When enabled, every event the commit
# hook fires is published to subjects like kiosk.{kiosk_code}.event.transaction.complete
# in addition to the local slog line. Disabled by default — leave it off
# until you have a central reporting consumer to receive these.
nats:
  enabled: false
  url: "nats://localhost:4222"
  # Protocol identifiers. Override only to avoid collisions on a shared NATS
  # cluster (e.g. another app already owns "kiosk.>" or "KIOSK_EVENTS").
  # Both kiosk and controller must use the same subject_prefix. stream_name
  # is controller-only — kiosks ignore it. Leave blank for the defaults.
  subject_prefix: ""    # default: "kiosk"
  stream_name: ""       # default: "KIOSK_EVENTS"
  # Use whichever auth your nats-server expects; leave all blank for anonymous.
  token: ""
  username: ""
  password: ""
  credentials_file: ""    # JWT .creds file (e.g. NGS / JetStream Cloud)
  nkey_seed_file: ""      # ed25519 NKey seed
  tls_ca_file: ""
  tls_cert_file: ""
  tls_key_file: ""
  tls_insecure: false     # skip cert verification — dev only

# Optional. Opts this kiosk into central management by the kiosk-controller.
# When enabled, the kiosk watches the JetStream KV buckets below for catalog
# updates and projects them into its local items/users tables; the admin SPA
# hides catalog edit affordances. Standalone kiosks leave this disabled.
#
# Requires nats.enabled=true with a connection to the same broker the
# controller publishes to. Bucket names default to "catalog_items",
# "catalog_users", and "catalog_groups" if blank.
controller:
  enabled: false
  catalog_items_bucket: "catalog_items"
  catalog_users_bucket: "catalog_users"
  catalog_groups_bucket: "catalog_groups"

# Optional. Customize the kiosk's visual identity. All keys are optional;
# omitted values fall back to built-in defaults. The example logo + tagline
# below match the file shipped at ./branding/logo.svg in the repo.
branding:
  logo_path: "./branding/logo.svg"   # served at /branding/logo (PNG or SVG)
  tagline: "Tool & Consumable Checkout"
  primary_color: ""                   # CSS color (e.g. "#059669") for primary action buttons
  # Optional escape hatch for visuals the typed fields above don't cover.
  # Point at a .css file; the binary serves it at /branding/custom.css and
  # the SPA injects a <link> for it AFTER Tailwind. Tailwind 4 emits every
  # color utility as a var(--color-<name>) reference, so overriding the
  # variable cascades through every bg-*/text-*/border-* utility. See
  # README.md → "Branding → Custom CSS overrides" for the full discussion,
  # and branding/theme.css.example for a starting point.
  custom_css_path: ""                # e.g. "./branding/theme.css"

# Optional. Opts this kiosk into RFID-driven inventory flows over a
# networked LLRP reader (e.g. an Impinj R700). Disabled by default;
# when off the binary behaves identically to a non-RFID install.
#
# Two modes:
#   - counter_scan    Operator hits a button on CheckoutView; kiosk runs
#                     a single inventory cycle and adds resolved tags as
#                     cart lines. Cart starts via the normal badge scan.
#   - enclosure_diff  External access-control / camera systems publish
#                     NATS commands at <prefix>.<code>.command.cart.start
#                     and .command.read.trigger; kiosk diffs observed
#                     EPCs against the expected-present set to derive
#                     checkout/return lines. enclosure_id is the opaque
#                     label for the access-controlled cabinet, used as part
#                     of the cart-start idempotency key (user_code,
#                     enclosure_id), so two enclosures sharing a kiosk can
#                     be told apart.
#
# Connection to the reader is best-effort: a failure at startup logs a
# warning and the binary continues, mirroring NATS unreachability
# handling. See docs/rfid.md for the full design.
# Optional. Clock-in/clock-out via an append-only punch ledger
# (time_punches), with optional interlocks against the tool ledger.
# Disabled by default; when off the feature does not exist (no splash
# button, endpoints 404). All defaults are false — an omitted block leaves
# existing deployments unchanged.
#
#   - require_clock_in_for_checkout  Commit rejects any cart containing
#     checkout/consume lines when the worker is not clocked in. Returns are
#     ALWAYS allowed regardless of punch state.
#   - block_clock_out_with_open_checkouts  Clock-out is rejected while the
#     worker has open checkouts at THIS kiosk (local-scoped by design; a
#     tool out at another kiosk doesn't block). Admins can force past it
#     with a reason — the "drove home with a tool" escape hatch.
#   - timeclock_only  Dedicated punch station: the SPA replaces the
#     checkout splash with a persistent punch panel and badge scans go
#     straight to it — no carts, no checkout. Pairs naturally with a gate
#     device feeding a managed fleet. Requires enabled=true. NOTE:
#     block_clock_out_with_open_checkouts is a no-op on a punch-only
#     station — open_checkouts is local-scoped and never written here, so
#     tools out at other kiosks won't block a clock-out at this one.
#
# In managed mode (controller.enabled=true + NATS), punches publish as
# events, the controller projects them fleet-wide, and per-user clocked-in
# state is distributed back to every kiosk via the punch_state KV bucket —
# so a worker can clock in at one kiosk and out at another. Standalone
# kiosks keep a local-only ledger. No payroll math anywhere: the raw-punch
# CSV export is the payroll contract.
#   - virtual  Marks the dedicated public, per-user-authenticated terminal
#     served by the cmd/timeclock binary (workers clock in/out from their
#     phones). NOT for cmd/kiosk — leave false here. See timeclock.yaml.example
#     for the virtual terminal's own config; it requires managed mode.
timeclock:
  enabled: false
  require_clock_in_for_checkout: false
  block_clock_out_with_open_checkouts: false
  timeclock_only: false
  virtual: false

rfid:
  enabled: false
  mode: ""                  # "counter_scan" | "enclosure_diff" (required when enabled)
  reader:
    host: ""                # reader IP / hostname (required when enabled)
    port: 5084              # standard LLRP port
    # antennas: enumerate active reader ports + TX power in dBm.
    # Empty/omitted = let the reader's own baseline stand. When set,
    # only the listed ports are inventoried and each runs at the given
    # power (resolved to the reader's nearest available index at Connect).
    # antennas:
    #   - id: 1
    #     tx_power_dbm: 25.0
    #   - id: 3
    #     tx_power_dbm: 20.0
  read_window: "3s"         # one inventory cycle; enclosure_diff caps this at 3.5s (runs inside the ~5s command reply)
  enclosure_id: ""          # required when mode=enclosure_diff (the access-controlled cabinet's id)
