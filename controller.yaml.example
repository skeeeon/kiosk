# kiosk-controller config. Loaded from ./controller.yaml by default;
# override with KIOSK_CONFIG=/path/to/file. Every YAML key has a matching
# KIOSK_* env override (prefix KIOSK_, dots to underscores, uppercase).
#
# The controller shares the Config struct with the kiosk binary — the
# `kiosk:` block is intentionally absent here because the controller isn't
# a kiosk (its identity comes from its place in the fleet, not from a code).

server:
  port: 8091
  bind: "127.0.0.1"

# JetStream KV bucket names the controller publishes catalog to. Managed
# kiosks must point at the same names on their side (controller.* block in
# kiosk.yaml). Defaults to "catalog_items" / "catalog_users" /
# "catalog_groups" when blank.
controller:
  catalog_items_bucket: "catalog_items"
  catalog_users_bucket: "catalog_users"
  catalog_groups_bucket: "catalog_groups"

# Optional. Customize the controller admin UI's visual identity. All keys
# are optional; omitted values fall back to built-in SPA defaults.
branding:
  logo_path: ""                       # served at /branding/logo
  tagline: "Fleet Controller"
  primary_color: ""                   # CSS color (e.g. "#0284c7")
  # Optional escape hatch — point at a .css file, served at /branding/custom.css
  # and injected after Tailwind. Override any Tailwind color variable on :root
  # to re-skin the SPA; see README.md → "Branding → Custom CSS overrides" and
  # branding/theme.css.example for a starting point.
  custom_css_path: ""                 # e.g. "./branding/theme.css"

# Optional. Surfaces the fleet timeclock UI (Reports → Timeclock tab,
# per-kiosk Record punch) on the controller's admin SPA. The aggregator
# always projects incoming timeclock.punch events regardless of this flag —
# it only gates the UI affordances. The interlock flags are kiosk-side
# settings and have no effect here.
timeclock:
  enabled: false

# NATS is REQUIRED for the controller — without a broker connection the
# controller has nothing to aggregate.
nats:
  enabled: true
  url: "nats://localhost:4222"
  # Protocol identifiers. Override only to avoid collisions on a shared NATS
  # cluster (e.g. another app already owns "kiosk.>" or "KIOSK_EVENTS").
  # The kiosk side's subject_prefix must match; stream_name is consumed
  # only here. Leave blank for the defaults.
  subject_prefix: ""    # default: "kiosk"
  stream_name: ""       # default: "KIOSK_EVENTS"
  token: ""
  username: ""
  password: ""
  credentials_file: ""
  nkey_seed_file: ""
  tls_ca_file: ""
  tls_cert_file: ""
  tls_key_file: ""
  tls_insecure: false
